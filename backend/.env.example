# NatMedSol backend — env template. Copy to `.env`, fill in real values.
# NEVER commit the populated `.env`.

# --- Mongo ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="natmedsol"

# --- HIPAA mode toggle (flip to true in production) ---
HIPAA_MODE=false

# --- JWT hardening (Sprint 1) ---
# In HIPAA mode all three are REQUIRED, no defaults, must have adequate entropy.
JWT_SECRET=                 # generate: openssl rand -hex 64
JWT_ISSUER=                 # e.g. natmedsol-emr
JWT_AUDIENCE=               # e.g. natmedsol-app

# --- MFA at-rest encryption key (Sprint 1b) ---
# 32 random bytes, base64-url encoded. Rotate periodically.
# generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MFA_ENC_KEY_B64=

# --- Password reset ---
PASSWORD_RESET_TOKEN_TTL_MIN=30
# DEV ONLY — never set in production. Ignored when HIPAA_MODE=true.
DEV_EXPOSE_RESET_TOKEN=

# --- Integrations (blank => sent_stub / disabled) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DAILY_API_KEY=
DAILY_DOMAIN=

# --- Amazon Bedrock (only supported AI provider) ---
# Authentication is via the EC2 instance IAM role. Do NOT set any
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here (or anywhere else in the
# application). See BEDROCK_SETUP.md for required IAM permissions.
AI_ENABLED=true
AI_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
AI_REQUEST_TIMEOUT_SECONDS=90

# --- PostgreSQL (auth-stack migration; see PG_MIGRATION_STATUS.md) ---
# Populated from AWS Secrets Manager in production. Never commit a value.
DATABASE_URL=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
FRONTEND_ORIGIN=

# --- WebRTC TURN (optional) ---
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- Web push VAPID ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# --- Security & backup ---
MALWARE_SCAN_MODE=clamscan
BACKUP_ENC_KEY_B64=
BACKUP_DIR=/var/backups/natmedsol
BACKUP_RETENTION_DAYS=30
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
