# =============================================================================
# Natural Medical Solutions — Backend .env template  (production)
# =============================================================================
#
# HOW TO USE
#   * Copy to `.env` on the target host: `cp .env.example .env`
#   * Fill in EVERY value that is empty below.
#   * NEVER commit `.env` to git (it is already covered by `.gitignore`).
#   * On EC2, production AWS authentication uses the instance IAM role —
#     do NOT paste `AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY` /
#     `AWS_SESSION_TOKEN` into this file. IAM roles rotate credentials
#     automatically and eliminate long-lived key risk.
#   * All application secrets (JWT_SECRET, MFA_ENC_KEY_B64, Stripe keys,
#     SendGrid keys, Twilio keys, Daily.co keys, VAPID keys, BOOTSTRAP_SECRET)
#     SHOULD be sourced from AWS Secrets Manager or the equivalent protected
#     deployment configuration (Parameter Store / Vault / K8s Secret).
#     Populating `.env` from the CI/CD stage of your deploy pipeline at
#     boot time is acceptable; hand-editing this file with real secrets
#     on the host is not.
# =============================================================================

# ---------------- Runtime mode ----------------
ENVIRONMENT=production
HIPAA_MODE=true
DEMO_SEED_DISABLE=true

# ---------------- PostgreSQL ----------------
# Async DSN — the app uses SQLAlchemy + asyncpg.
# Example: postgresql+asyncpg://emrapp:PASSWORD@db.internal:5432/natmedsol
DATABASE_URL=

# ---------------- Application / JWT ----------------
# JWT_SECRET & SESSION_JWT_SECRET must be strong random values (>= 64 bytes).
# Rotate on a scheduled cadence; the app tolerates one prior secret during
# rollover via SESSION_JWT_PREVIOUS_SECRETS (comma-separated) if you use it.
JWT_SECRET=
JWT_ISSUER=natmedsol-emr
JWT_AUDIENCE=natmedsol-app
SESSION_JWT_SECRET=

# ---------------- MFA encryption ----------------
# Base64-encoded 32-byte key used to encrypt TOTP secrets at rest.
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MFA_ENC_KEY_B64=

# ---------------- Frontend, hosts, and CORS ----------------
FRONTEND_ORIGIN=https://YOUR_DOMAIN
ALLOWED_ORIGINS=https://YOUR_DOMAIN
ALLOWED_HOSTS=YOUR_DOMAIN,www.YOUR_DOMAIN,localhost,127.0.0.1

# ---------------- Session lifecycle ----------------
WORKFORCE_IDLE_TIMEOUT_MIN=15
WORKFORCE_ABSOLUTE_SESSION_HOURS=12
CLIENT_IDLE_TIMEOUT_MIN=60
CLIENT_ABSOLUTE_SESSION_DAYS=7
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_CONCURRENCY_GRACE_SECONDS=5
MAX_ACTIVE_WORKFORCE_SESSIONS=200
MAX_ACTIVE_CLIENT_SESSIONS=200

# ---------------- S3 storage (blob backend) ----------------
# The application replaced MongoDB GridFS with S3 in Phase 3.7.
#
# For production ALWAYS use STORAGE_BACKEND=s3. The `filesystem` backend
# is provided for local development only and is not HIPAA-compliant.
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_KMS_KEY_ARN=
S3_PRESIGN_EXPIRES_SECONDS=300
# Local-dev override — safe to leave empty in production.
# STORAGE_FS_ROOT=/var/lib/emr/blobs

# ---------------- Security ----------------
MALWARE_SCAN_MODE=clamd
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
PASSWORD_RESET_TOKEN_TTL_MIN=30
DEV_EXPOSE_RESET_TOKEN=false

# ---------------- Admin bootstrap ----------------
# BOOTSTRAP_SECRET protects the one-shot first-admin creation endpoint.
# Use a high-entropy random value; delete after the first admin is created.
BOOTSTRAP_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_TEMP_PASSWORD_TTL_HOURS=24

# ---------------- Integrations ----------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

DAILY_API_KEY=
DAILY_DOMAIN=

# ---------------- Bedrock (AI) ----------------
AI_ENABLED=true
AI_PROVIDER=bedrock
BEDROCK_MODEL_ID=
AI_REQUEST_TIMEOUT_SECONDS=90

# ---------------- Telehealth: TURN + Web Push ----------------
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# ---------------- Rate limiting ----------------
RATE_LIMIT_TEST_MODE=false

# =============================================================================
# The following variables are intentionally NOT included:
#
#   MONGO_URL / DB_NAME
#     MongoDB was retired in Phase 3.7. PostgreSQL is authoritative for all
#     structured data; S3 stores file blobs. Only offline migration tools
#     (backup.py, scripts/backfill_gridfs_to_storage.py) still read these
#     from the shell environment.
#
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
#     Production uses the EC2 IAM role. Never place static AWS keys in this
#     file. For local development, use `AWS_PROFILE` or a temporary session
#     from `aws sso login`.
#
#   Google OAuth (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / etc.)
#     Removed in Session 2a — authentication is JWT-only.
#
#   GridFS / Mongo indexes
#     Removed in Phase 3.7.
# =============================================================================
